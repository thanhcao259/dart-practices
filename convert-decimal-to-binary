class EggCounter{
  void convertDecimalToBinary(int number){
    var copiedNumber = number;
    List<int> binary = [];
    var result = '';
    while(copiedNumber > 0){
      var reminder = copiedNumber%2;
      print('${copiedNumber} / 2 = ${copiedNumber ~/ 2}, reminder = ${reminder} ');
      copiedNumber = copiedNumber ~/ 2;
      binary.add(reminder);
    }
    // Reverse the list to give a string binary
    for(var i=binary.length - 1; i >= 0; i--){
      result += binary[i].toString();
    } print(result);
  }

  int count(int number){
    int result = 0;
    while(number > 0){
      result += number % 2;
      number = number ~/ 2;
    } return result;
  }
}

void main(){
  EggCounter egg = new EggCounter();
  egg.convertDecimalToBinary(89);
  print(egg.count(89));

}
