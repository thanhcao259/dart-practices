class EggCounter{
  void convertDecimalToBinary(int number){
    List<int> reminders = [];
    var binary = '';
    while(number > 0){
      reminders.add(number % 2);
      number = number ~/ 2;
    }
    // Reverse the list to give a string binary
    for(var i=reminders.length - 1; i >= 0; i--){
      binary += reminders[i].toString();
    } print(binary);
  }

  int count(int number){
    int result = 0;
    while(number > 0){
      result += number % 2;
      number = number ~/ 2;
    } return result;
  }
}

void main(){
  EggCounter egg = new EggCounter();
  egg.convertDecimalToBinary(8);
  print(egg.count(8));

}
